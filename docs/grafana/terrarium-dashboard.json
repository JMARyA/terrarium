      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (archived) (terrarium_states_total)",
          "legendFormat": "archived={{archived}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "title": "State change velocity",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(terrarium_state_pushes_total{workspace=~\"$workspace\"}[$__rate_interval]))",
          "legendFormat": "push {{result}}"
        },
        {
          "refId": "B",
          "expr": "sum by (result) (rate(terrarium_state_pulls_total{workspace=~\"$workspace\"}[$__rate_interval]))",
          "legendFormat": "pull {{result}}"
        },
        {
          "refId": "C",
          "expr": "sum(rate(terrarium_state_version_creations_total{workspace=~\"$workspace\"}[$__rate_interval]))",
          "legendFormat": "versions created"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "title": "State byte deltas p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(terrarium_state_change_bytes_bucket[$__rate_interval])) by (le))",
          "legendFormat": "change p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(terrarium_state_push_bytes_bucket[$__rate_interval])) by (le))",
          "legendFormat": "push size p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "95th-percentile size of state changes and pushes \u2014 spots unusually large writes."
    },
